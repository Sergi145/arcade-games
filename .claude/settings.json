{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$input | & \".claude/hooks/format-on-write.ps1\"",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier + ESLint..."
          }
        ]
      }
    ]
  }
}
